@page "/my-profile"

@rendermode InteractiveServer

@inject EmployeeService vm

<h3><i class="bi bi-person-gear"></i> Thông Tin Nhân Viên Cửa Hàng</h3>

<div class="container mt-4" style="max-width: 600px;">
    @if (CurrentOwner == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải thông tin tài khoản...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center p-4">
                <div class="fs-1"><i class="bi bi-person-circle"></i></div>
                <h4 class="mb-0 mt-2">@CurrentOwner.FullName</h4>
                <small class="text-white-50">Nhân Viên Cửa Hàng</small>
            </div>
            <div class="card-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và Tên</label>
                    <input class="form-control" @bind="CurrentOwner.FullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email Hệ Thống</label>
                    <input class="form-control" type="email" @bind="CurrentOwner.Email" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mã Đăng Nhập (Login ID)</label>
                    <input class="form-control" type="number" @bind="CurrentOwner.EmployeeCode" disabled />
                    <small class="text-muted">* Mã đăng nhập cố định theo tài khoản hệ thống.</small>
                </div>

                <div class="d-grid">
                    <button class="btn btn-primary" @onclick="UpdateProfile">
                        <i class="bi bi-save"></i> Cập Nhật Thông Tin
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @(message.Contains("thành công") ? "alert-success" : "alert-danger") mt-3 text-center" role="alert">
                        @message
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    DtoEmployee? CurrentOwner;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        DtoResult<DtoEmployee> rs = await vm.GetAllAsync();
        if (rs.Succeed && rs.ResultList != null && rs.ResultList.Count > 0)
        {
            CurrentOwner = rs.ResultList[0];
        }
    }

    private async Task UpdateProfile()
    {
        if (CurrentOwner == null) return;

        DtoResult<DtoEmployee> ketQua = await vm.UpdateAsync(CurrentOwner);

        message = ketQua.Succeed ? "Cập nhật thông tin thành công!" : "Cập nhật thất bại!";

        await InvokeAsync(StateHasChanged);
    }
}