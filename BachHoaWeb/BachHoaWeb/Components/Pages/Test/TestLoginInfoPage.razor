@page "/loginInfo-test"
@rendermode InteractiveServer


@inject LoginInfoService loginInfoVM
@inject EmployeeService employeeVM

<div class="container mt-5" style="max-width: 450px;">
    @if (IsLoggedIn == false)
    {
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h4>ĐĂNG NHẬP HỆ THỐNG</h4>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="form-label">Tài khoản (UserID)</label>
                    <input class="form-control" @bind="txtUser" placeholder="Nhập 'admin'" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu (PassWord)</label>
                    <input class="form-control" type="password" @bind="txtPass" placeholder="Nhập '123'" />
                </div>
                <button class="btn btn-primary w-100 mt-2" @onclick="HandleLogin">Đăng Nhập</button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3 text-center">@errorMessage</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow border-success">
            <div class="card-header bg-success text-white text-center">
                <h5>ĐĂNG NHẬP THÀNH CÔNG!</h5>
                <small>Hệ thống tự động liên kết dữ liệu...</small>
            </div>
            <div class="card-body">
                @if (CurrentOwner == null)
                {
                    <div class="text-center p-3">
                        <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                        <p class="text-muted mt-2">Đang tìm thông tin chủ cửa hàng trong bảng Employee...</p>
                    </div>
                }
                else
                {
                    <div class="text-center mb-3">
                        <i class="bi bi-person-check-fill text-success fs-1"></i>
                        <h5>Xin chào: @CurrentOwner.FullName</h5>
                        <p class="text-muted">Email: @CurrentOwner.Email</p>
                        <span class="badge bg-secondary">Mã liên kết LoginId: @CurrentOwner.EmployeeCode</span>
                    </div>
                }
                <button class="btn btn-outline-danger btn-sm w-100" @onclick="Logout">Đăng xuất</button>
            </div>
        </div>
    }
</div>

@code {
    string txtUser = "";
    string txtPass = "";
    string errorMessage = "";
    bool IsLoggedIn = false;
    DtoEmployee? CurrentOwner;

    private async Task HandleLogin()
    {
        errorMessage = "";

        // 1. Kiểm tra tài khoản dưới DB thông qua LoginInfoService
        DtoResult<FullLogin> LoginList = await loginInfoVM.GetLogin();
        var loginResult = LoginList.ResultList.FirstOrDefault(x=>x.UserID == txtUser);
        if(loginResult==null)
        {
            errorMessage = "Tài khoản không tồn tại";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (loginResult.Password != txtPass)
            errorMessage = "Sai mật khẩu";
        else
            errorMessage = "Đăng nhập thành công";
        await InvokeAsync(StateHasChanged);

    }

    private void Logout()
    {
        IsLoggedIn = false;
        CurrentOwner = null;
        txtUser = "";
        txtPass = "";
    }
}