@page "/test"


@rendermode InteractiveServer

@inject CategoryService vm

<h3>TestPage</h3>

<div>
    <div class="d-flex">
        <label for="cateName">Tên Nhóm</label>
        <input class="form-control" @bind="SelectedData.CateName"/>
    </div>
    <div class="align-items-center justify-content-center d-flex mt-2">
        <button class="btn btn-success" @onclick="AddCate">Thêm Cate</button>
    </div>
    <div class="mt-2">
        <p>@message</p>
    </div>
    <div class="mt-2">
        <table class="table table-striped">
            <thead class="table-info">
                <tr>
                    <th>Tên Nhóm</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Data)
                {
                    <tr>
                        <td>@item.CateName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    List<DtoCategory> Data = [];
    DtoCategory SelectedData = new();
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        DtoResult<DtoCategory> rs = await vm.GetAllAsync();
        if(rs.Succeed && rs.ResultList!=null)
        {
            Data = rs.ResultList;
        }
    }

    private async Task AddCate()
    {
        DtoResult<DtoCategory> ketQua = await vm.AddAsync(SelectedData);
        message = ketQua.Succeed ? "Lưu thành công" : "Lưu thất bại";
        if (ketQua.Succeed)
            {
                Data.Add(ketQua.Result);
                SelectedData = new();
            }

        await InvokeAsync(StateHasChanged);
    }
}
