@using Application.Asset.Common
@using Application.Assets.Dtos
@* ===================== VIEW ===================== *@
@if (Visible)
{
    <div class="cd-overlay" @onclick="OnOverlayClick">
        <div class="cd-dialog" @onclick:stopPropagation="true">

            <!-- HEADER -->
            <div class="cd-header">
                @if (Icon != DialogIcon.None)
                {
                    <div class="cd-icon">@GetIcon()</div>
                }
                <div class="cd-title">@Title</div>
            </div>

            <!-- BODY -->
            <div class="cd-body">
                @Message
            </div>

            <!-- FOOTER -->
            <div class="cd-footer">
                @switch (Type)
                {
                    case DialogType.OkOnly:
                        <button class="btn cd-btn-primary" @onclick="() => Close(DialogResult.Ok)">
                            @OkText
                        </button>
                        break;

                    case DialogType.OkCancel:
                        <button class="btn cd-btn-primary" @onclick="() => Close(DialogResult.Ok)">
                            @OkText
                        </button>
                        <button class="btn cd-btn-secondary" @onclick="() => Close(DialogResult.Cancel)">
                            @CancelText
                        </button>
                        break;

                    case DialogType.YesNo:
                        <button class="btn cd-btn-primary" @onclick="() => Close(DialogResult.Yes)">
                            @YesText
                        </button>
                        <button class="btn cd-btn-secondary" @onclick="() => Close(DialogResult.No)">
                            @NoText
                        </button>
                        break;

                    case DialogType.YesNoCancel:
                        <button class="btn cd-btn-primary" @onclick="() => Close(DialogResult.Yes)">
                            @YesText
                        </button>
                        <button class="btn cd-btn-secondary" @onclick="() => Close(DialogResult.No)">
                            @NoText
                        </button>
                        <button class="btn cd-btn-light" @onclick="() => Close(DialogResult.Cancel)">
                            @CancelText
                        </button>
                        break;
                }
            </div>
        </div>
    </div>
}

@* ===================== CODE ===================== *@
@code {

    // ===== ENUM =====
    

    // ===== PARAM =====
    [Parameter] public string Title { get; set; } = "Thông báo";
    [Parameter] public string Message { get; set; } = "";

    [Parameter] public DialogType Type { get; set; } = DialogType.OkOnly;
    [Parameter] public DialogIcon Icon { get; set; } = DialogIcon.None;

    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string YesText { get; set; } = "Yes";
    [Parameter] public string NoText { get; set; } = "No";

    [Parameter] public EventCallback<DialogResult> OnClose { get; set; }

    // ===== STATE =====
    public bool Visible { get; set; }
    private TaskCompletionSource<DialogResult>? _tcs;

    // ===== METHODS =====

    public Task<DialogResult> ShowAsync(string message, string? title = null, DialogType type = DialogType.OkOnly, DialogIcon icon = DialogIcon.None)
    {
        Message = message;
        if (title != null)
            Title = title;

        Type = type;
        Icon = icon;

        Visible = true;

        _tcs = new TaskCompletionSource<DialogResult>();

        StateHasChanged();
        return _tcs.Task;
    }

    public void Hide()
    {
        Visible = false;
        StateHasChanged();
    }

    private async Task Close(DialogResult result)
    {
        Visible = false;

        _tcs?.TrySetResult(result); // trả kết quả

        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync(result);
    }

    private string GetIcon()
    {
        return Icon switch
        {
            DialogIcon.Warning => "⚠️",
            DialogIcon.Question => "❓",
            DialogIcon.Info => "ℹ️",
            DialogIcon.Success => "✔️",
            _ => ""
        };
    }

    private async Task OnOverlayClick()
    {
        // click ngoài = cancel
        if (Type == DialogType.OkOnly)
            await Close(DialogResult.Ok);
        else
            await Close(DialogResult.Cancel);
    }
}
