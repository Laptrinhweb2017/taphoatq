@typeparam TItem

<div class="ftb-container" @onkeydown="HandleKeyDown">

    <div class="ftb-input-wrapper">
        @if(Id==null)
        {
            <input class="form-control"
                   autocomplete="new-password"
                   @bind="Value"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   @onblur="HandleBlur" />
        }
        else
        {
            <input class="form-control"
                   autocomplete="new-password"
                   id="@Id"
                   @bind="Value"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   @onblur="HandleBlur" />
        }

        @if (!string.IsNullOrEmpty(Value))
        {
            <span class="ftb-clear" @onclick="Clear">✕</span>
        }
    </div>

    @if (IsOpen)
    {
        <div class="ftb-dropdown" style="@DropdownStyle">

            @foreach (var (item, index) in FilteredItems.Select((x, i) => (x, i)))
            {
                <div class="ftb-item @(index == ActiveIndex ? "active" : "")"
                     @onclick="() => SelectItem(item)">
                    @Highlight(DisplaySelector(item))
                </div>
            }

        </div>
    }

</div>

@code {

    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public Func<TItem, string> DisplaySelector { get; set; }

    private bool _typing = false;

    private string _value;
    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_value == value)
                return;

            _value = value;

            ApplyFilter();

            // 🔥 CHỈ mở khi user vừa gõ
            if (_typing)
            {
                IsOpen = ShouldOpen();
                _typing = false;
            }

            _ = ValueChanged.InvokeAsync(_value);
        }
    }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; } = null;

    [Parameter] public int MinWidth { get; set; } = 200;

    private bool IsOpen;
    private int ActiveIndex = -1;
    private List<TItem> FilteredItems = new();
    private bool _hasInteracted = false;
    private bool _justRendered = true;

    #region INIT
    protected override void OnAfterRender(bool firstRender)
    {
        _justRendered = false;
    }

    protected override void OnParametersSet()
    {
        FilteredItems = Items ?? new();
        ApplyFilter(); // KHÔNG được set IsOpen trong đây
    }

    #endregion

    #region INPUT

    
    private void HandleInput(ChangeEventArgs e)
    {
        // Value đã được @bind set rồi

        // 🔥 CHỈ mở khi user gõ
        IsOpen = ShouldOpen();
    }
    #endregion

    #region FILTER

    private void ApplyFilter()
    {
        if (Items == null)
        {
            FilteredItems = new();
            return;
        }

        if (string.IsNullOrWhiteSpace(Value))
        {
            FilteredItems = Items.ToList();
            return;
        }

        var keywords = SplitKeywords(Value)
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .ToList();

        FilteredItems = Items
            .Where(x =>
            {
                var text = Normalize(DisplaySelector(x) ?? "");
                return keywords.All(k => text.Contains(k));
            })
            .ToList();

        ActiveIndex = FilteredItems.Count > 0 ? 0 : -1;
    }
    private bool ShouldOpen()
    {
        return !string.IsNullOrWhiteSpace(Value)
            && FilteredItems.Count > 0;
    }
    #endregion

    #region SELECT

    private async Task SelectItem(TItem item)
    {
        _typing = false;

        Value = DisplaySelector(item);

        IsOpen = false;

        await ValueChanged.InvokeAsync(Value);
    }

    #endregion

    #region CLEAR

    private async Task Clear()
    {
        _typing = false;

        Value = "";

        IsOpen = false;
        ActiveIndex = -1;

        await ValueChanged.InvokeAsync(Value);
    }

    #endregion

    #region UI

    

    private async Task HandleBlur(FocusEventArgs e)
    {
        await Task.Delay(120);
        IsOpen = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // 🔥 chỉ nhận key tạo ký tự
        if (IsTypingKey(e))
            _typing = true;

        if (!IsOpen || FilteredItems.Count == 0)
            return;

        if (e.Key == "ArrowDown")
            ActiveIndex = Math.Min(ActiveIndex + 1, FilteredItems.Count - 1);

        else if (e.Key == "ArrowUp")
            ActiveIndex = Math.Max(ActiveIndex - 1, 0);

        else if (e.Key == "Enter")
        {
            var item = FilteredItems.ElementAtOrDefault(ActiveIndex);
            if (item != null)
                _ = SelectItem(item);
        }
    }
    private bool IsTypingKey(KeyboardEventArgs e)
    {
        // ký tự thường (a, b, c, 1, 2...)
        if (!string.IsNullOrEmpty(e.Key) && e.Key.Length == 1)
            return true;

        // backspace / delete cũng là input
        if (e.Key == "Backspace" || e.Key == "Delete")
            return true;

        return false;
    }

    #endregion

    #region HIGHLIGHT

    private MarkupString Highlight(string text)
    {
        if (string.IsNullOrWhiteSpace(Value))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var keywords = SplitKeywords(Value);

        string lowerText = Normalize(text);

        var sb = new System.Text.StringBuilder();
        int i = 0;

        while (i < text.Length)
        {
            bool matched = false;

            foreach (var k in keywords)
            {
                if (string.IsNullOrWhiteSpace(k))
                    continue;

                var remaining = text.Substring(i);

                if (Normalize(remaining).StartsWith(k))
                {
                    var len = 1;

                    // 🔥 IMPORTANT: tăng từng ký tự gốc, không dùng normalized index
                    while (len + i < text.Length &&
                           Normalize(text.Substring(i, len)) != k)
                    {
                        len++;
                    }

                    sb.Append("<mark>");
                    sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(i, len)));
                    sb.Append("</mark>");

                    i += len;
                    matched = true;
                    break;
                }
            }

            if (!matched)
            {
                sb.Append(System.Net.WebUtility.HtmlEncode(text[i].ToString()));
                i++;
            }
        }

        return (MarkupString)sb.ToString();
    }
    #endregion

    #region UTIL

    private List<string> SplitKeywords(string input)
        => Normalize(input)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .ToList();

    private string Normalize(string text)
    {
        if (string.IsNullOrEmpty(text))
            return "";

        return new string(text.ToLower()
            .Normalize(System.Text.NormalizationForm.FormD)
            .Where(c =>
                System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());
    }

    private string DropdownStyle => $"min-width:{MinWidth}px;width:100%;";

    #endregion

}
<style>
    .ftb-container { position: relative; width:100%; }

    .ftb-input-wrapper { position:relative; }

    .ftb-clear {
        position:absolute;
        right:8px;
        top:50%;
        transform:translateY(-50%);
        cursor:pointer;
        color:#999;
    }

    .ftb-dropdown {
        position:absolute;
        top:100%;
        left:0;
        z-index:9999;
        background:white;
        border:1px solid #ccc;
        border-radius:0 0 10px 10px;
        max-height:250px;
        overflow-y:auto;
        margin-top:5px;
    }

    .ftb-item {
        padding:8px;
        cursor:pointer;
    }

    .ftb-item.active {
        background:white;
        color:black;
    }

    .ftb-item:hover {
        background-color:lightblue;
        color:darkblue;
    }

    mark {
        background:yellow;
        padding:0;
    }
</style>
