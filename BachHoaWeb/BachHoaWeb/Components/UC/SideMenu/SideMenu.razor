@using MyControl
@rendermode InteractiveServer

@inject NavigationManager NavMan

<style>
    /* Nền chung */
    .menu-background {
        width: 250px;
        height: 85vh;
        /*background: linear-gradient(to bottom,lightgrey 0%, white 30%, lightgrey 60%, grey 100%); /*Đây là màu nền của sidebar*/
        display: flex;
        flex-direction: column;
        padding: 10px 0;
        font-family: sans-serif;
        border-radius:0 0 15px 15px;
        background-color:#002db3;
    }
    /* Wrapper */
    .menu-item-wrapper {
        display: flex;
        flex-direction: column;
    }

    /* Item chung */
    .menu-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 8px 16px;
        cursor: pointer;
        transition: background-color .15s, filter .15s;
        color: white; /*Đây là màu của menu text*/
        font-size: 14px;
        line-height: 1.4;
        width: 100%;
        box-sizing: border-box;
        background-color: transparent; /* reset mặc định */
    }

        /* icon */
        .menu-item .icon {
            width: 26px;
            font-size: 15px; /*size này cùng text*/
            text-align: center;
            margin-right: 8px;
        }

        /* Menu text */
        .menu-item .menu-link {
            flex: 1;
            color: inherit;
            text-decoration: none;
            font-size: 15px; /*size này cùng icon*/
        }



        .menu-item .chev {
            opacity: 0.8;
        }
        /* hover: hiệu ứng hover trên các menu item */
        .menu-item:hover,
        .menu-item.depth-1:hover,
        .menu-item.depth-2:hover,
        .menu-item.depth-3:hover,
        .menu-item.depth-4:hover,
        .menu-item.active:hover,
        .menu-item.parent-active:hover {
            filter: brightness(0.8); /*Do nền sáng nên dùng 0.x cho nền sậm đi 1 tí khi hover mỗi item
                                          Nếu nền tối dùng 1.x để khi hover nền sáng lên 1 tí*/
        }

        /* active */
        .menu-item.active,
        .menu-item.depth-1.active,
        .menu-item.depth-2.active,
        .menu-item.depth-3.active,
        .menu-item.depth-4.active,
        .menu-item.parent-active {
            filter: brightness(0.9); /* sáng hơn thì 1.x, sậm hơn thì 0.x */
            border-radius: 12px 0 0 12px; /*độ bo cong cạnh trái của item được chọn, nếu không muốn bo cong thì bỏ đi*/
            font-weight: bold;
        }

        .menu-item .row {
            align-items: flex-start !important; /* icon và text đều canh top */
        }

        .menu-item .icon {
            margin-top: 2px; /* cho có khoảng hở sẽ đẹp hơn, có thể 0 hoặc 3px tùy font */
        }
    /* chev: Mũi tên biểu thị menu con đang expand hay collapsed */
    .chev-icon {
        font-size: 25px; /* chỉnh to/nhỏ tùy ý */
        line-height: 1;
        display: inline-block;
    }

    .disabled-link {
        flex: 1;
        pointer-events: none;
        text-decoration: none;
        color: #8fa2f0 !important;
        font-size: 15px; /*size này cùng icon*/
    }
    /* submenu */
    .submenu-panel { /*Panel chứa các item con*/
        display: flex;
        flex-direction: column;
        padding-left: 28px; /* Thụt lề vào trong ứng với từng cấp con */
    }

    /* Màu nền xen kẽ cấp */
    .menu-item.depth-1 {
        /* background-color: #d9d9d9;  cấp 1: màu này sẽ sậm hơn nền của sidebar 1 tí */
        background-color: #002db3; /* cấp 1: Màu này trùng với sidebar, cấp 1 sẽ dính vào sidebar */
        color: white; /*màu text cấp 1*/
    }

    .menu-item.depth-2 {
        background-color: #e6f2ff; /* cấp 2 */
        color: saddlebrown; /*màu text cấp 2*/
    }

    .menu-item.depth-3 {
        background-color: #ffe6f0; /* cấp 3 */
        color: darkgreen; /*màu text cấp 3*/
    }

    .menu-item.depth-4 {
        background-color: #f5e6ff; /* cấp 4 */
        color: darkolivegreen; /*màu text cấp 4*/
    }
</style>

<nav class="@MenuBackgroundStyle">
    @foreach (var item in MenuItems)
    {
        <!-- SideMenu passes its local HandleNavigate down to MenuItemComp -->
        <MenuItemComp Item="item" Depth="1" NavigateRequested="HandleNavigate" />
    }
</nav>

@code {
    [Parameter] public List<MenuItem> MenuItems { get; set; } = new();
    [Parameter] public string MenuBackgroundStyle { get; set; } = "menu-background";
    

    // bindable show state (for mobile)
    [Parameter] public bool ShowNavMenu { get; set; } = false;
    [Parameter] public EventCallback<bool> ShowNavMenuChanged { get; set; }

    // Optional: incoming handler from NavMenu (layout). If set, SideMenu will forward requests up.
    [Parameter] public EventCallback<string> NavigateRequested { get; set; }

    // Called by MenuItemComp; SideMenu decides to forward to layout or handle itself
    private async Task HandleNavigate(string link)
    {
        if (NavigateRequested.HasDelegate)
        {
            await NavigateRequested.InvokeAsync(link); // bubble up to layout
            return;
        }

        // fallback: SideMenu handles navigation + closes (if bound)
        NavMan.NavigateTo(link);
        await ShowNavMenuChanged.InvokeAsync(false);
    }
}
