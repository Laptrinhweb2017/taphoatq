@using Microsoft.AspNetCore.Components.Web

<div class="previewer-container">
    <div class="preview-frame" style="background-color:@BackgroundColor"
         @onpointerdown="OnPointerDown"
         @onpointerup="OnPointerUp">
         @{ string[] strs = ImagePath.Split('/');
            string ProdID = strs.LastOrDefault()!;
        }
        <img src="@CurrentImage"
             class="preview-image @(isFading ? "fade" : "")"
             @onclick="() => OnPreviewImgClicked.InvokeAsync(new PreviewImgClickArgs(ImageList, ProdID, CurrentImage))"
             style="cursor:zoom-in"/>
        <button class="nav-btn left" @onclick="PrevImage" disabled="@(!CanPrevImg)">&#10094;</button>
        <button class="nav-btn right" @onclick="NextImage" disabled="@(!CanNextImg)">&#10095;</button>
    </div>
    @if(ShowThumbnail)
    {
        <div class="thumbnail-frame">
            @foreach (var img in CurrentPageImages)
            {
                if (img.ImgName != FixedValue)
                {
                    <img src="@($"{ImagePath}/{img.ImgName}")"
                         class="thumbnail @(img.ImgName == ImageList[CurrentIndex] ? "active" : "")"
                         @onclick="() => ChangeImage(img)" />
                }
                else
                {
                    <img src="@($"{FixedPath}/{img.ImgName}")"
                         class="thumbnail @(img.ImgName == ImageList[CurrentIndex] ? "active" : "")"
                         @onclick="() => ChangeImage(img)" />
                }
            }
        </div>

        <div class="pagination justify-content-between w-100" style="gap: 8px;">
            <div class="d-flex align-items-center" style="gap: 8px;">
                <button class="btn btn-info py-0 px-2" @onclick="FirstPage" disabled="@(!CanPrevPage)"
                        style="@buttonColor; font-size:20px">
                    <i class="bi bi-skip-backward-fill p-0 m-0" style="color:darkgreen"></i>
                </button>
                <button class="btn btn-info py-0 px-2" @onclick="PrevPage" disabled="@(!CanPrevPage)"
                        style="@buttonColor; font-size:20px">
                    <i class="bi bi-caret-left-fill p-0 m-0" style="color:darkgreen"></i>
                </button>
            </div>

            <span class="mx-3 flex-grow-1 text-center" style="font-weight:600">
                @(CurrentPage + 1) / @TotalPages
            </span>

            <div class="d-flex align-items-center" style="gap: 8px;">
                <button class="btn btn-info py-0 px-2" @onclick="NextPage" disabled="@(!CanNextPage)"
                        style="@buttonColor; font-size:20px">
                    <i class="bi bi-caret-right-fill p-0 m-0" style="color:darkgreen"></i>
                </button>
                <button class="btn btn-info py-0 px-2" @onclick="LastPage" disabled="@(!CanNextPage)"
                        style="@buttonColor; font-size:20px">
                    <i class="bi bi-skip-forward-fill p-0 m-0" style="color:darkgreen"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string BackgroundColor { get; set; } = "white";
    [Parameter] public string ButtonColor { get; set; } = "";
    private string buttonColor = "background-color:white";
    [Parameter] public List<string> ImageList { get; set; } = new();
    [Parameter] public string ImagePath { get; set; } = string.Empty;
    [Parameter] public string FixedPath { get; set; } = string.Empty;
    [Parameter] public string FixedValue { get; set; } = string.Empty;
    [Parameter] public string NoImagePath { get; set; } = string.Empty;
    [Parameter] public EventCallback<PreviewImgClickArgs> OnPreviewImgClicked { get; set; }
    [Parameter] public bool ShowThumbnail { get; set; } = true;
    private int CurrentIndex = 0;

    public record PreviewImgClickArgs(List<string> ImageSrc, string ProdID, string currentImg);

    private bool isFading = false;
    private double startX;
    private double startY;
    private bool isSwiping = false;

    private int CurrentPage => CurrentIndex / 4;
    private int TotalPages => (int)Math.Ceiling(ImageList.Count / 4.0);
    private bool CanPrevPage => CurrentPage > 0;
    private bool CanNextPage => CurrentPage < TotalPages - 1;

    private bool CanNextImg => ImageList.Count >= 2 && CurrentIndex<ImageList.Count-1;
    private bool CanPrevImg => CurrentIndex > 0;

    private List<ImgIndex> CurrentPageImages
    {
        get
        {
            List<ImgIndex> result = [];
            List<string> names = ImageList.Skip(CurrentPage * 4).Take(4).ToList();
            foreach (string item in names)
            {
                result.Add(
                    new()
                        {
                            CurrentIndex = Array.IndexOf(names.ToArray(),item),
                            ImgName = item
                        }
                );
            }

            return result;
        }
    }
    private class ImgIndex
    {
        public string ImgName { get; set; } = "";
        public int CurrentIndex { get; set; }
    }

    private string CurrentImage
    {
        get
        {
            if (ImageList.Count > 0)
            {
                if (ImageList[CurrentIndex] != FixedValue)
                    return $"{ImagePath}/{ImageList[CurrentIndex]}";
                else
                    return $"{FixedPath}/{ImageList[CurrentIndex]}";
            }
            else
                return null;
        }
    } 

    protected override void OnParametersSet()
    {
        if(!string.IsNullOrEmpty(ButtonColor))
        {
            ButtonColor = $"background-color:{ButtonColor}";
        }
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        startX = e.ClientX;
        startY = e.ClientY;
        isSwiping = true;
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (!isSwiping)
            return;
        isSwiping = false;

        double deltaX = e.ClientX - startX;
        double deltaY = e.ClientY - startY;

        // tránh trường hợp kéo dọc
        if (Math.Abs(deltaX) < 50 || Math.Abs(deltaY) > Math.Abs(deltaX))
            return;

        if (deltaX > 0)
            PrevImage();
        else
            NextImage();
    }

    private async Task ChangeImage(ImgIndex img)
    {
        int newIndex = img.CurrentIndex + CurrentPage*4;
        if (newIndex == CurrentIndex)
            return;

        await FadeToImage(newIndex);
    }

    private async void NextImage()
    {
        int nextIndex = (CurrentIndex + 1) % ImageList.Count;
        await FadeToImage(nextIndex);
    }

    private async void PrevImage()
    {
        int prevIndex = (CurrentIndex - 1 + ImageList.Count) % ImageList.Count;
        await FadeToImage(prevIndex);
    }

    private async Task FadeToImage(int newIndex)
    {
        isFading = true;
        StateHasChanged();
        await Task.Delay(150); // fade out
        CurrentIndex = newIndex;
        StateHasChanged();
        await Task.Delay(150); // fade in
        isFading = false;
        StateHasChanged();
    }

    private void NextPage()
    {
        if (CanNextPage)
            CurrentIndex = Math.Min(ImageList.Count - 1, (CurrentPage + 1) * 4);
    }
    private void LastPage()
    {
        if (CanNextPage)
            CurrentIndex = ImageList.Count - 1;
    }

    private void PrevPage()
    {
        if (CanPrevPage)
            CurrentIndex = Math.Max(0, (CurrentPage - 1) * 4);
    }
    private void FirstPage()
    {
        if (CanPrevPage)
            CurrentIndex = 0;
    }
}
