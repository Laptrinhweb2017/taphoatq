@using MyControl
@typeparam TItem

@if (Headers != null && ColumnWidths != null)
{
    <div class="treelist-header d-none d-md-grid sticky-top"
         style="grid-template-columns:@GetHeaderGridTemplate();">
        <div class="tl-cell tl-expander"></div>

        @foreach (var h in Headers)
        {
            <div class="tl-cell header-cell">@h</div>
        }

        @if (ShowDelete.Last())
        {
            <div class="tl-cell header-cell"></div>
        }
        @if (ShowEdit.Last())
        {
            <div class="tl-cell header-cell"></div>
        }
    </div>
}
<div class="p-2" style="background-color:@MainBGColor">
    <TreeListView TItem="TItem"
                  Items="Items"
                  Level="0"
                  IndentPx="IndentPx"
                  ExpanderWidth="ExpanderWidth"
                  ColumnWidths="ColumnWidths"
                  SelectedRowBg="SelectedRowBg"
                  SelectionState="_selectionState"
                  KeyFieldNames="KeyFieldNames"
                  DisplayProperties="DisplayProperties"
                  ChildPropertyNames="ChildPropertyNames"
                  Headers="Headers"
                  ShowDelete="ShowDelete"
                  ShowEdit="ShowEdit"
                  OnSelectionChanged="OnSelectionChanged"
                  OnRowDbleClicked="OnRowDbleClicked"
                  OnRowClicked="OnRowClicked"
                  OnDeleteClicked="OnDeleteClicked"
                  OnEditClicked="OnEditClicked"
                  ColumnFormats="ColumnFormats"
                  ConditionalFormats="ConditionalFormats"
                  SetToFields="SetToFields"
                  ApplyOnlyLeafLevel="ApplyOnlyLeafLevel"
                  TextCSS="TextCSS"
                  LinkFields="LinkFields"
                  Styles="Styles" />

</div>
                
@code {
    [Parameter] public string MainBGColor { get; set; } = "white";
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }
    [Parameter] public List<List<int>>? ColumnWidths { get; set; }
    [Parameter] public int ExpanderWidth { get; set; } = 40;
    [Parameter] public int IndentPx { get; set; } = 20;
    [Parameter] public string? SelectedRowBg { get; set; }
    [Parameter] public List<List<string>>? DisplayProperties { get; set; }
    [Parameter] public List<List<string>> TextCSS { get; set; } = [];
    [Parameter] public List<List<string>> Styles { get; set; } = [];
    [Parameter] public Dictionary<string, string>? ColumnFormats { get; set; }
    [Parameter] public Dictionary<string, Dictionary<string, string>> ConditionalFormats { get; set; } = [];

    [Parameter] public List<string>? SetToFields { get; set; }

    [Parameter] public bool ApplyOnlyLeafLevel { get; set; } = true;

    [Parameter] public List<bool> ShowEdit { get; set; } = [];
    [Parameter] public List<bool> ShowDelete { get; set; } = [];

    [Parameter] public List<string>? Headers { get; set; } 
    [Parameter] public List<string>? ChildPropertyNames { get; set; }
    [Parameter] public List<string>? KeyFieldNames { get; set; }
    [Parameter] public List<string> LinkFields { get; set; } = [];

    [Parameter] public EventCallback<object> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<object> OnRowClicked { get; set; }
    [Parameter] public EventCallback<object> OnRowDbleClicked { get; set; }
    [Parameter] public EventCallback<object> OnEditClicked { get; set; }
    [Parameter] public EventCallback<object> OnDeleteClicked { get; set; }

    private TreeSelectionState _selectionState = new();
    private string GetHeaderGridTemplate()
    {
        var cols = new List<string>();

        // Expander
        var expander = ExpanderWidth > 30 ? ExpanderWidth : 30;
        cols.Add($"{expander}px");

        // Columns theo LAST level
        var widths = ColumnWidths!.Last();

        foreach (var w in widths)
            cols.Add($"{w}fr");

        // Buttons
        if (ShowDelete.Any(x=>x==true))
            cols.Add("40px");
        if (ShowEdit.Any(x => x== true))
            cols.Add("40px");

        return string.Join(" ", cols);
    }

}
