@typeparam TItem
@typeparam TValue

<div @ref="wrapperRef" class="input-group filter-select-wrapper" style="position: relative;">
    @if(!ReadOnly)
    {
        <input type="text" class="form-control @Bootstrap"
               placeholder="@Placeholder"
               id="@Id"
               style="@CSS"
               autocomplete="new-password"
               @bind="SearchText"
               @bind:event="oninput"
               @onfocus="ShowDropdown"
               @onclick="ShowDropdown" />

        <button type="button" class="btn btn-outline-primary btn-hover-effect" @onclick="ToggleDropdown">▼</button>
    }
    else
    {
        <input type="text" class="form-control @Bootstrap"
               placeholder="@Placeholder"
               style="@CSS"
               id="@Id"
               readonly
               @bind="SearchText"/>

        <button type="button" class="btn btn-outline-primary btn-hover-effect" disabled>▼</button>
    }

    @if (isDropdownOpen && filteredItems?.Any() == true)
    {
        <ul class="dropdown-menu show filter-dropdown">
            @foreach (var item in filteredItems)
            {
                <li>
                    <a class="dropdown-item" @onclick="() => SelectItem(item)">
                        @ItemTextSelector(item)
                    </a>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public Func<TItem, string> ItemTextSelector { get; set; } = default!;
    [Parameter] public Func<TItem, TValue> ItemValueSelector { get; set; } = default!;
    [Parameter] public string? Placeholder { get; set; } = "Vui lòng chọn...";
    [Parameter] public string? Id { get; set; } = "selectFilter";
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public string CSS { get; set; } = "";
    [Parameter] public string Bootstrap { get; set; } = "";


        private List<TItem> filteredItems = new();
    private bool isDropdownOpen = false;

    private string searchText = "";
    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            FilterItems();
        }
    }

    private ElementReference wrapperRef;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<FilterSelect<TItem, TValue>>? dotNetRef;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override void OnParametersSet()
    {
        filteredItems = Items?.ToList() ?? new List<TItem>();
        if (Value != null && Items != null)
        {
            var selected = Items.FirstOrDefault(x => EqualityComparer<TValue>.Default.Equals(ItemValueSelector(x), Value));
            if (selected != null)
            {
                searchText = ItemTextSelector(selected);
            }
        }
        else
        {
            searchText = string.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            const string jsCode = @"
                let handler = null;

                export function attachOutsideClick(wrapper, dotnetHelper) {
                    handler = function (event) {
                        if (!wrapper.contains(event.target)) {
                            dotnetHelper.invokeMethodAsync('CloseDropdownAsync');
                        }
                    };
                    document.addEventListener('mousedown', handler);
                }

                export function detachOutsideClick(wrapper) {
                    if (handler) {
                        document.removeEventListener('mousedown', handler);
                        handler = null;
                    }
                }
            ";

            // Tạo module từ data URI
            var moduleDataUrl = $"data:text/javascript;charset=utf-8,{Uri.EscapeDataString(jsCode)}";
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", moduleDataUrl);

            dotNetRef = DotNetObjectReference.Create(this);
            await jsModule.InvokeVoidAsync("attachOutsideClick", wrapperRef, dotNetRef);
        }
    }

    [JSInvokable("CloseDropdownAsync")]
    public Task CloseDropdownAsync()
    {
        isDropdownOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void FilterItems()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredItems = Items?.ToList() ?? new List<TItem>();
        }
        else
        {
            filteredItems = Items?
                .Where(x => ItemTextSelector(x).Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList() ?? new List<TItem>();
        }
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void ShowDropdown()
    {
        isDropdownOpen = true;
    }

    private async Task SelectItem(TItem item)
    {
        Value = ItemValueSelector(item);
        searchText = ItemTextSelector(item);
        isDropdownOpen = false;
        await ValueChanged.InvokeAsync(Value);
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            await jsModule.InvokeVoidAsync("detachOutsideClick", wrapperRef);
            await jsModule.DisposeAsync();
        }

        dotNetRef?.Dispose();
    }
}
