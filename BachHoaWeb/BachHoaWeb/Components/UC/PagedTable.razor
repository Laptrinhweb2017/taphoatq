@using System.Linq
@using Application.Assets.Dtos
@typeparam TItem

<div>
    <table class="table table-striped table-hover">
        <thead class="table-info">
            <tr>
                @foreach (var header in Headers)
                {
                    string[] splits = header.Split(":");
                    string colWidth = ColWidths.Length > 0 ? ColWidths[Array.IndexOf(Headers,header)] : "";
                    <th class="@(splits.Length > 1 && !string.IsNullOrEmpty(splits[1]) ? splits[1] : "")"
                        style="width:@colWidth">@splits[0]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in PagedData)
            {
                @if(SetDataRow)
                {
                    <tr>
                        @RowTemplate(item)
                    </tr>
                }
                else
                {
                    @RowTemplate(item)
                }
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage">«</button>
            </li>

            @for (int i = 1; i <= TotalPages; i++)
            {
                var vpage = i;
                <li class="page-item @(CurrentPage == vpage ? "active" : "")">
                    <button class="page-link" @onclick="() => ChangePage(vpage)">@vpage</button>
                </li>
            }

            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage">»</button>
            </li>
        </ul>
    </nav>
</div>

@code {
    [Parameter] public List<TItem> Data { get; set; } = [];
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public string[] Headers { get; set; } = [];
    [Parameter] public string[] ColWidths { get; set; } = [];
    [Parameter] public int PageSize { get; set; } = 5;
    [Parameter] public bool SetDataRow { get; set; } = true;

    private int CurrentPage = 1;

    private int TotalPages => (int)Math.Ceiling((double)Data.Count / PageSize);

    private IEnumerable<TItem> PagedData => Data
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private void ChangePage(int page) => CurrentPage = page;

    private void PreviousPage()
    {
        if (CurrentPage > 1)
            CurrentPage--;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
            CurrentPage++;
    }
}
