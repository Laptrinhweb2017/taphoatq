@inherits LayoutComponentBase
@inject LayoutService layoutService



<div class="page">
    <div>
        <NavbarMenu/>
    </div>

    <main>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>



<ModalForm />
@code {
    protected override Task OnInitializedAsync()
    {
        layoutService.OnChange += StateHasChanged;
        return base.OnInitializedAsync();
    }
}