@using BachHoaWeb.Components.UC.SideMenu
@using MyControl
@inject NavigationManager NavMan
@inject LoginViewModel UserVM


<div class="navbar d-flex d-md-none align-items-center" style="height:56px;">
    <div class="ms-2 align-items-center d-flex d-md-none">
        <a class="btn btn-dark"
           style="height:90%; background-color:darkblue; width:100%;"
           href="/">
            Trang chủ
        </a>
    </div>
    <div class="ms-2 align-items-center d-flex d-md-none">
        <a class="btn btn-dark"
           style="height:90%; background-color:darkblue; width:100%;"
           @onclick="LogoutUser">
            Đăng Xuất
        </a>
    </div>
    <button class="d-md-none ms-auto bg-transparent border-0 me-3"
            @onclick="@(() => ShowNavMenu = !ShowNavMenu)">
        <span class="navbar-toggler"></span>
    </button>
</div>

<div class="d-none d-md-block">
    <div class="d-flex align-items-center justify-content-center" style="height:56px; background-color: #002db3;">
        <!-- Sử dụng máy tính thì không cần làm gì, hiển thị lên -->
        <a class="btn btn-dark align-content-center"
           style="height:80%; background-color:darkblue; width:90%;"
           href="/">
            <i class="bi bi-house"></i> Trang Chủ
        </a>
    </div>
    <SideMenu MenuItems="MenuItems" />
</div>

@if (ShowNavMenu)
{
    <div class="d-block d-md-none sticky-top">
        <!-- trên di động, khi click vào item thì sẽ ẩn cái menu đi -->
        <SideMenu MenuItems="MenuItems"
                  @bind-ShowNavMenu="ShowNavMenu"
                  NavigateRequested="OnNavigateFromMenu" />
    </div>
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool ShowNavMenu = false;

    List<MenuItem> MenuItems = new();
    private void SetMenuEnable(MenuItem item, string? allow)
    {
        item.Checked = item.SubItems != null && item.SubItems.Count > 0;
        item.Enabled = UserVM.LoggedIn &&
                       (item.IDPermission != null && allow != null &&
                           allow.Contains($"{item.IDPermission}|") ||
                        item.IDPermission == null);
        if (item.SubItems != null && item.SubItems.Count > 0)
        {
            foreach (MenuItem sub in item.SubItems)
            {
                SetMenuEnable(sub, allow);
            }
            if (item.SubItems.FirstOrDefault(x => x.Enabled) != null)
                item.Enabled = true;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var user = authState.User;

        string? permission = user.FindFirst("Permit") != null ? user.FindFirst("Permit")!.Value : null;

        UserVM.LoggedIn = permission != null;
        //UserVM.OnChange += UserChange;
        // build menu items properly as C# lists
        MenuItems = new List<MenuItem>
            {
                    new MenuItem
                {
                    MenuText = "Quản lý",
                    Icon = "bi bi-person-badge",
                    IDPermission = "01",
                    SubItems =
                    [
                        new MenuItem
                        {
                            MenuText = "Khách hàng",
                            Icon = "bi bi-people",
                            IDPermission = "10",
                            LinkToPage = "/customer",
                        },
                        new MenuItem
                        {
                            MenuText = "Nhân viên",
                            Icon = "bi bi-person-workspace",
                            IDPermission = "11",
                            LinkToPage = "/employee",
                        },
                    ]
                },

                new MenuItem
                {
                    MenuText = "Quản lý sản phẩm",
                    Icon = "bi bi-box-seam",
                    IDPermission = "02",
                    SubItems =
                    [
                        new MenuItem
                        {
                            MenuText = "Danh mục",
                            Icon = "bi bi-grid",
                            IDPermission = "12",
                            LinkToPage = "/category",
                        },
                        new MenuItem
                        {
                            MenuText = "Sản phẩm",
                            Icon = "bi bi-bag",
                            IDPermission = "13",
                            LinkToPage = "/product",
                        },
                        new MenuItem
                        {
                            MenuText = "Thương hiệu",
                            Icon = "bi bi-bookmark-star",
                            IDPermission = "14",
                            LinkToPage = "/brand",
                        },
                    ]
                },

                new MenuItem
                {
                    MenuText = "Kho",
                    Icon = "bi bi-building",
                    IDPermission = "03",
                    SubItems =
                    [
                        new MenuItem
                        {
                            MenuText = "Kho hàng",
                            Icon = "bi bi-buildings",
                            IDPermission = "15",
                            LinkToPage = "/warehouse",
                        },
                        new MenuItem
                        {
                            MenuText = "Nhập kho",
                            Icon = "bi bi-box-arrow-in-down",
                            IDPermission = "16",
                            LinkToPage = "/stock-input",
                        },
                        new MenuItem
                        {
                            MenuText = "Xuất kho",
                            Icon = "bi bi-box-arrow-up",
                            IDPermission = "17",
