                            LinkToPage = "/report",
                        },
                    ]
       

                },

                new MenuItem
                {
                    MenuText = "Hệ thống",
                    Icon = "bi bi-gear",
                    IDPermission = "06",
                    SubItems =
                    [
                        new MenuItem
                        {
                            MenuText = "Thông tin cửa hàng",
