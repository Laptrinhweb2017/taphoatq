                            IDPermission = "22",
                            LinkToPage = "/store-info",
                        },
                    ]
                },
            };
        // string? permiss = UserVM.LoggedUser!.Permission;
        // foreach (MenuItem item in MenuItems)
        // {
        //     SetMenuEnable(item, permiss);
        // }
        UserChange(permission);

    }
    private void UserChange(string? permission)
    {
        // string? permiss;
        // if (!UserVM.LoggedIn)
        // {
        //     permiss = null;
        // }
        // else
        // {
        //     permiss = UserVM.LoggedUser.Permission;
        // }
        permission = permission ?? "";
        foreach (MenuItem item in MenuItems)
        {
            SetMenuEnable(item, permission);
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnNavigateFromMenu(string link)
    {
        // Xử lý link khi ở màn hình di động
        NavMan.NavigateTo(link);
        ShowNavMenu = false;
        StateHasChanged();
    }
    public void Dispose()
    {
        UserVM.OnChange -= StateHasChanged;
    }
    private async Task LogoutUser(MouseEventArgs args)
    {
        await InvokeAsync(() =>
        {
            NavMan.NavigateTo("/logout");
        });
    }

}
