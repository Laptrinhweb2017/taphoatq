@using System.Globalization
@using Application.Asset.ViewDtos
@using Application.Assets.FullDto
@using TextProcessing

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject HeaderInfo headerInfo
@inject LoginViewModel vm
@inject NavigationManager NavMan
@inject UserInfoViewModel userVM
@inject AuthenticationStateProvider AuthProvider



<div class="header-line d-none d-md-flex">
    <p class="header-title mt-0 mb-0 ">@headerInfo.HeadTitle</p>
    @if (vm.LoggedIn)
    {
        <div class="ms-auto me-2 align-items-center d-flex">
            <p class="p-0 m-0 me-2 text-black d-inline-block">@TimePeriod, <span class="header-user fst-italic fw-bold"> @headerInfo.LogingName</span></p>
@*             <select class="form-select" @bind="CurrentCulture" @bind:after="ChangeLang"
                    style="width:auto">
                <option value="vi-VN">🇻🇳 </option>
                <option value="en-US">🇺🇸 </option>
            </select> *@
            <button class="btn btn-light btn-logout px-2 w-auto mx-2" @onclick="LogoutUser">Đăng Xuất</button>
            <button class="btn btn-info w-auto px-2" @onclick="ChangePass">Đổi Mật Khẩu</button>
        </div>
    }
</div>
<ModalDialog TData="FullLogin" @ref="staffDialog"
             Title="Đổi mật khẩu"
             DataObject="@userVM.ChangUPass"
             ShowDeleteButton="true"
             OnSaveClicked="SavePass"
             IsSucceed="@passSucceed"
             Height="350px">
             <FormTemplate Context="pass">
        <div class="mb-2 row">
            <label class="p-0 m-0 col-12 col-md-2" for="oldPass">Mật khẩu cũ</label>
            <div class="col-12 col-md-10">
                <input type="password" class="px-2 py-1 m-0 mx-2 form-control" @bind="@userVM.OldPass" id="oldPass" />
            </div>
        </div>
        <div class="mb-2 row">
            <label class="p-0 m-0 col-12 col-md-2" for="newPass">Mật khẩu mới</label>
            <div class="col-12 col-md-10">
                <input type="password" class="px-2 py-1 m-0 mx-2 form-control" @bind="@userVM.NewPass" id="newPass" />
            </div>
        </div>
        <div class="mb-2 row">
            <label class="p-0 m-0 col-12 col-md-2" for="conPass">Nhập lại</label>
            <div class="col-12 col-md-10">
                <input type="password" class="px-2 py-1 m-0 mx-2 form-control" @bind="@userVM.ConfirmPass" id="conPass" />
            </div>
        </div>
             </FormTemplate>
</ModalDialog>
<PopupMessage Duration="5000" Position="PopupMessage.PopupPosition.BottomRight" @ref="popup" Style="PopupMessage.PopupMessageStyle.Green"/>
@code {
    string TimePeriod = "";
    string CurrentCulture = "vi-VN";
    ModalDialog<FullLogin> staffDialog = default!;
    PopupMessage popup = default!;
    bool passSucceed = false;
    protected override void OnInitialized()
    {
        //CurrentCulture = CultureInfo.CurrentUICulture.Name;
        // var cultureName = CultureInfo.CurrentUICulture.Name;
        // if (cultureName.Equals("vi-vn", StringComparison.OrdinalIgnoreCase))
        //     CurrentCulture = "vi-VN";
        // else if (cultureName.Equals("en-us", StringComparison.OrdinalIgnoreCase))
        //     CurrentCulture = "en-US";
        // else
        //     CurrentCulture = "vi-VN"; // Mặc định nếu không khớp
        headerInfo.OnChange += ChangeHeader;
        int hour = DateTime.Now.Hour;
        if (hour < 11)
            TimePeriod = "goodmorning";
        else if(hour <16)
            TimePeriod = "goodafternoon";
        else if (hour < 18)
            TimePeriod = "goodevening";
        else
            TimePeriod = "goodnight";

        // headerInfo.HeadTitle = CurrentCulture;
    }

    bool already = false;
    private void ChangeHeader()
    {
        InvokeAsync(StateHasChanged);
    }
    private async Task LogoutUser(MouseEventArgs args)
    {
        await InvokeAsync(() =>
        {
            NavMan.NavigateTo("/logout", forceLoad:true);
        });
    }
    void ChangeLang()
    {
        var uri = new Uri(NavMan.Uri).PathAndQuery;
        NavMan.NavigateTo($"/culture/set?culture={CurrentCulture}&redirectUri={uri}", forceLoad: true);

    }
    string? UserCode = "";

    private async Task ChangePass(MouseEventArgs args)
    {
        await staffDialog.ShowAsync();
    }
    private async Task SavePass()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        UserCode = user.FindFirst("StaffCode")?.Value;

        if (UserCode == null)
        {
            NavMan.NavigateTo("/login");
            return;
        }
        if (UserCode != null)
        {
            await vm.GetLogin(UserCode);
        }
        Encryption encryption = new();

        if (userVM.OldPass != vm.LoggedUser.Password)
        {
            popup.ShowMessage("Mật khẩu cũ không đúng", PopupMessage.PopupMessageStyle.Red);
            return;
        }
        if(userVM.NewPass != userVM.ConfirmPass)
        {
            popup.ShowMessage("Mật khẩu mới không khớp", PopupMessage.PopupMessageStyle.Red);
            return;
        }
        
        await userVM.UpdatePass();
        if(!userVM.ErrMess.EndsWith("thành công"))
        {
            popup.ShowMessage(userVM.ErrMess, PopupMessage.PopupMessageStyle.Red);
        }
        else
        {
            popup.ShowMessage(userVM.ErrMess, PopupMessage.PopupMessageStyle.Green);
            await staffDialog.CloseAsync();
        }
    }
}