@using System.Linq
@typeparam TItem

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3"> 
    @* <div class="col">
            <div class="card shadow-sm rounded-3">
                <div>
                    <img src="assets/img/product/@prod.ImgPath" class="bd-placeholder-img card-img-top" alt="Product Image" height="225" width="100%" />
                    <label class="form-label text-center mx-3 prod-title">@prod.ProdName</label>
                </div>
                <div class="card-body">
                    <p class="card-text">@prod.Descr</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-primary">Xem</button>
                            <button type="button" class="btn btn-sm btn-success">Đặt Hàng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@ 
    @foreach (var item in PagedData)
    {
        @RowTemplate(item)
    }
    
</div>
<nav>
    <ul class="pagination my-3">
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="PreviousPage">«</button>
        </li>

        @for (int i = 1; i <= TotalPages; i++)
        {
            var vpage = i;
            <li class="page-item @(CurrentPage == vpage ? "active" : "")">
                <button class="page-link" @onclick="() => ChangePage(vpage)">@vpage</button>
            </li>
        }

        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <button class="page-link" @onclick="NextPage">»</button>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public List<TItem> Data { get; set; } = new();
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public int PageSize { get; set; } = 5;

    private int CurrentPage = 1;

    private int TotalPages => (int)Math.Ceiling((double)Data.Count / PageSize);

    private IEnumerable<TItem> PagedData => Data
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private void ChangePage(int page) => CurrentPage = page;

    private void PreviousPage()
    {
        if (CurrentPage > 1)
            CurrentPage--;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
            CurrentPage++;
    }
}
