@typeparam TData

@if (_visible)
{
    <div class="modal-backdrop-custom"
         @onmouseup="CloseOutSideAsync"
         @onmousedown="() => outsideClick = true">
        <div class="modal-container"
             @onmousedown:stopPropagation
             @onmouseup:stopPropagation
             style="--modal-width:@Width; --modal-height:@Height">

            <div class="modal-header">
                <span class="modal-title">@Title</span>
                <button class="btn-close" @onclick="CloseAsync"></button>
            </div>

            <div class="modal-body">
                @if (DataObject != null)
                {
                    @FormTemplate(DataObject)
                }
                else
                {
                    <p class="text-danger">Dữ liệu không hợp lệ.</p>
                }
            </div>

            <div class="modal-footer">
                @if(ShowConfirmButton)
                {
                    <button class="@StyleConfirmButton"
                            disabled="@(!CanConfirm)"
                            @onclick="SaveData">
                        @ConfirmButtonText
                    </button>
                }

                <button class="@StyleCancelButton ms-2"
                        @onclick="Cancel">
                    @CancelButtonText
                </button>

                @if (ShowDeleteButton)
                {
                    <button class="@StyleDeleteButton ms-4"
                            disabled="@(!CanDelete)"
                            @onclick="Delete">
                        @DeleteButtonText
                    </button>
                }
            </div>

        </div>
    </div>
}
@code {
    [Parameter] public TData DataObject { get; set; } = default!;
    [Parameter] public RenderFragment<TData> FormTemplate { get; set; } = default!;

    [Parameter] public string Width { get; set; } = "800px";
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public string Title { get; set; } = "Edit Dialog";

    [Parameter] public bool CanConfirm { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; } = true;

    [Parameter] public string ConfirmButtonText { get; set; } = "Lưu";
    [Parameter] public string CancelButtonText { get; set; } = "Hủy";
    [Parameter] public string DeleteButtonText { get; set; } = "Xóa";

    [Parameter] public bool IsSucceed { get; set; }
    [Parameter] public EventCallback<bool> IsSucceedChanged { get; set; }

    /// <summary>
    /// Sự kiện khi nhấn nút save
    /// </summary>
    [Parameter] public Func<Task>? OnSaveClicked { get; set; }
    /// <summary>
    /// Sự kiện khi nhấn nút Cancel
    /// </summary>
    [Parameter] public Action? OnCanceleClicked { get; set; }
    /// <summary>
    /// Sự kiện khi nhấn nút Delete
    /// </summary>
    [Parameter] public Func<Task>? OnDeleteClicked { get; set; }
    /// <summary>
    /// Sự kiện khi nhấn nút Đóng dialog
    /// </summary>
    [Parameter] public Action? OnCloseClicked { get; set; }

    /// <summary>
    /// Bootstrap
    /// </summary>
    [Parameter] public string StyleConfirmButton { get; set; } = "btn btn-success";
    /// <summary>
    /// Bootstrap
    /// </summary>
    [Parameter] public string StyleCancelButton { get; set; } = "btn btn-secondary";
    /// <summary>
    /// Bootstrap
    /// </summary>
    [Parameter] public string StyleDeleteButton { get; set; } = "btn btn-danger";
    [Parameter] public bool ShowDeleteButton { get; set; } = true;
    [Parameter] public bool ShowConfirmButton { get; set; } = true;

    private bool _visible;

    public async Task ShowAsync()
    {
        _visible = true;

        if (IsSucceed)
        {
            IsSucceed = false;
            await IsSucceedChanged.InvokeAsync(false);
        }

        await InvokeAsync(StateHasChanged);
    }

    private bool outsideClick = false;

    private async Task CloseOutSideAsync()
    {
        if(outsideClick)
        {
            outsideClick = false;
            OnCloseClicked?.Invoke();
            _visible = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task CloseAsync()
    {
        OnCloseClicked?.Invoke();
        _visible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveData()
    {
        if (OnSaveClicked != null)
            await OnSaveClicked.Invoke();

        if (IsSucceed)
            await CloseAsync();
    }

    private async Task Cancel()
    {
        OnCanceleClicked?.Invoke();
        await CloseAsync();
    }

    private async Task Delete()
    {
        if (OnDeleteClicked != null)
            await OnDeleteClicked.Invoke();

        if (IsSucceed)
            await CloseAsync();
    }
}