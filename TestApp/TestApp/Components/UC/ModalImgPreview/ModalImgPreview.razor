
<style>
    .form-window {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 10px;
    }

    .image-previewer {
        position: relative;
        width: 100%; /* Giới hạn chiều ngang */
        height: 100%; /* Giới hạn chiều dọc */
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden; /* Ẩn tràn */
        background-color: rgba(0, 0, 0, 0.8);
        border-radius: 10px;
    }

    /* Ảnh luôn vừa khung cả ngang và dọc */
    .preview-img {
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        max-height: 100%;
        max-width: 100%;
    }

    .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.4);
        color: white;
        border: none;
        font-size: 2rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
        z-index: 10;
        border-radius: 5px;
    }

        .nav-btn:hover {
            background-color: rgba(0, 0, 0, 0.7);
        }

    .prev {
        left: 10px;
    }

    .next {
        right: 10px;
    }
    .close-button{
        background-color:red;
        border:1px solid white;
        border-radius:50%;
        padding:3px;
        width:30px;
        height:30px;
        color: white;
        top: 20px;
        right: 20px;
        position: fixed;
        z-index: 3;
        text-align:center;
        align-content:center;
        align-items:center;
    }
    .close-button:hover{
        background-color:lightcoral;
    }
</style>
@if(_visible)
{
    <div>
        <div id="backdrop" style="position:fixed;inset:0;background-color:rgba(40,20,30,0.8);z-index:@(ZIndex);"></div> <!--backdrop-->
        <div id="form" style="background-color: @(FormBackColor);width:@(Width);height:@(Height);z-index:@(ZIndex + 1);" class="form-window">
            <button type="button" class="close-button" @onclick="() => CloseAsync()">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="image-previewer">
                <button class="nav-btn prev" @onclick="PrevImage">&#10094;</button>
                <img src="@CurrentImg" class="preview-img" />
                <button class="nav-btn next" @onclick="NextImage">&#10095;</button>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public RenderFragment FormTemplate { get; set; }
    [Parameter] public int ZIndex { get; set; } = 1000;
    [Parameter] public string Width { get; set; } = "90vw";
    [Parameter] public string Height { get; set; } = "95vh";
    [Parameter] public string FormBackColor { get; set; } = "White";
    [Parameter] public List<string> ImgList { get; set; } = [];
    [Parameter] public string ImgPath { get; set; } = "";
    [Parameter] public string CurrentImg { get; set; } = "";
    [Parameter] public int CurrentIndex { get; set; } = 0;
    private bool _visible = true;

    protected override void OnParametersSet()
    {
        if (CurrentIndex >= 0 && CurrentIndex < ImgList.Count)
            CurrentImg = Path.Combine(ImgPath, ImgList[CurrentIndex]);
    }

    public async Task CloseAsync()
    {
        _visible = false;
        await InvokeAsync(StateHasChanged);
    }
    private void NextImage()
    {
        int nextIndex = CurrentIndex + 1;
        if (nextIndex == ImgList.Count)
            nextIndex = 0;
        CurrentImg = Path.Combine(ImgPath, ImgList[nextIndex]);
        CurrentIndex = nextIndex;
        StateHasChanged();
    }

    private void PrevImage()
    {
        int nextIndex = CurrentIndex - 1;
        if (nextIndex < 0)
            nextIndex = ImgList.Count - 1;
        CurrentImg = Path.Combine(ImgPath, ImgList[nextIndex]);
        CurrentIndex = nextIndex;
        StateHasChanged();
    }

}
