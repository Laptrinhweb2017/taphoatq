@typeparam TData

@if (_visible)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show" tabindex="-1" style="display:block;">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg res-size">
            @{
                string minwidth = MinWidth != 0 ? $"{MinWidth}px" : "60vw";
            }
            <div class="modal-content rounded-3" style="min-width:@minwidth;max-width:@(MaxWidth)px; max-height: 90vh; display: flex; flex-direction: column;">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="() => CloseAsync()"></button>
                </div>

                <!-- Body (scrollable if long) -->
                <div class="modal-body flex-grow-1 overflow-auto mx-2">
                    @if (DataObject != null)
                    {
                        @FormTemplate(DataObject)
                    }
                    else
                    {
                        <p class="text-danger">Dữ liệu không hợp lệ hoặc không được cung cấp.</p>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    @if(CanDelete)
                    {
                        <button type="button" class="@StyleConfirmButton" @onclick="SaveData">@ConfirmButtonText</button>
                    }
                    else
                    {
                        <button type="button" class="@StyleConfirmButton" disabled>@ConfirmButtonText</button>
                    }
                    <button type="button" class="@StyleCancelButton" @onclick="Cancel">@CancelButtonText</button>
                    @if (ShowDeleteButton)
                    {
                        if(CanDelete)
                        {
                            <button type="button" class="@StyleDeleteButton" @onclick="Delete">@DeleteButtonText</button>
                        }
                        else
                        {
                            <button type="button" class="@StyleDeleteButton" disabled>@DeleteButtonText</button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

}
@code {
    [Parameter] public TData DataObject { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Edit Dialog";
    [Parameter] public string ConfirmButtonText { get; set; } = "Lưu";
    [Parameter] public string CancelButtonText { get; set; } = "Hủy";
    [Parameter] public string DeleteButtonText { get; set; } = "Xóa";
    [Parameter] public RenderFragment<TData> FormTemplate { get; set; }
    [Parameter] public bool CanConfirm { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; } = true;
    [Parameter] public int MaxWidth { get; set; } = 800;
    [Parameter] public int MinWidth { get; set; } = 0;

    // Action delegates
    public Func<Task>? OnSaveClicked { get; set; }
    public Action? OnCanceled { get; set; }
    public Func<Task>? OnDeleted { get; set; }
    public Action? OnClosed { get; set; }

    // Style
    [Parameter] public string StyleConfirmButton { get; set; } = "btn btn-success";
    [Parameter] public string StyleCancelButton { get; set; } = "btn btn-secondary";
    [Parameter] public string StyleDeleteButton { get; set; } = "btn btn-danger";
    [Parameter] public bool ShowDeleteButton { get; set; } = true;

    // Two-way binding cho IsSucceed
    [Parameter] public bool IsSucceed { get; set; }
    [Parameter] public EventCallback<bool> IsSucceedChanged { get; set; }

    private bool _visible;

    private async Task SaveData()
    {
        if (OnSaveClicked != null)
            await OnSaveClicked.Invoke();

        if (IsSucceed)
        {
            _visible = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task Cancel()
    {
        if (OnCanceled != null)
            OnCanceled.Invoke();

        _visible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Delete()
    {
        if (OnDeleted != null)
            await OnDeleted.Invoke();

        if (IsSucceed)
        {
            _visible = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async Task ShowAsync()
    {
        _visible = true;
        await InvokeAsync(StateHasChanged);

        // reset trạng thái khi mở mới
        if (IsSucceed)
        {
            IsSucceed = false;
            await IsSucceedChanged.InvokeAsync(false);
        }
    }

    public async Task CloseAsync()
    {
        if (OnClosed != null)
            OnClosed.Invoke();
        _visible = false;
        await Cancel();
        await InvokeAsync(StateHasChanged);
    }
}

