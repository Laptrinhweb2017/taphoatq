@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<textarea id="@Id"></textarea>

@code {
    [Parameter] public string Id { get; set; } = $"tinymce_{Guid.NewGuid()}";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private DotNetObjectReference<TinyMCEEditor>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "initTinyMCE",
                Id,
                _dotNetRef,
                Value ?? ""
            );

            _initialized = true;
        }
    }

    /// 🔥 Blazor nhận content từ JS
    [JSInvokable]
    public async Task OnContentChanged(string content)
    {
        Value = content;
        await ValueChanged.InvokeAsync(content);
    }

    /// ✅ Re-init an toàn
    public async Task ReInitAsync(string content)
    {
        await JS.InvokeVoidAsync("destroyTinyMCE", Id);

        if (_dotNetRef == null)
            _dotNetRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "initTinyMCE",
            Id,
            _dotNetRef,
            content
        );
    }

    /// ✅ Cleanup
    public async ValueTask DisposeAsync()
    {
        if (!_initialized)
            return;

        try
        {
            await JS.InvokeVoidAsync("destroyTinyMCE", Id);
            _dotNetRef?.Dispose();
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
