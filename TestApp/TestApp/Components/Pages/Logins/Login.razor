@page "/login"
@using System.Security.Claims
@using Application.Asset.Dtos
@using Application.Assets.FullDto
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

@inject LoginViewModel vm
@inject NavigationManager NavMan
@layout LoginLayout
@inject IJSRuntime JS


<div class="login-container">
    <div class="login-box py-4">
        <EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm">
            <DataAnnotationsValidator />
            <div class="mb-3 text-center flex-column">
                <h2>ĐĂNG NHẬP</h2>
            </div>
            <div class="mb-3">
                <label for="taikhoan"><i class="bi bi-person"></i> Tài khoản</label>
                <InputText @bind-Value="Model.UserID" class="form-control" 
                            placeholder="Tài khoản" 
                            id="taikhoan"
                            autofocus="autofocus" />
                <ValidationMessage For="() => Model.UserID" />
            </div>
            <div class="mb-3">
                <label><i class="bi bi-key-fill"></i>Mật khẩu</label>
                <InputText @bind-Value="Model.Password" class="form-control" placeholder="Mật khẩu" type="password" id="passwordField" />
                <ValidationMessage For="() => Model.Password" />
            </div>
            <div class="mb-1">
                <input type="checkbox" onchange="togglePassword()" id="pass" />
                <label for="pass">Hiển thị mật khẩu</label>
            </div>

            <div class="mb-3 text-center">
                <span class="text-danger">@errMess</span>
                @if(HasErr)
                {
                    <script> document.getElementById("taikhoan")?.focus(); </script>
                }
                @if (PassErr)
                {
                    <script> document.getElementById("passwordField")?.focus(); </script>
                }
            </div>
            <div class="mb-3 d-grid gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-unlock2-fill"></i>Đăng Nhập</button>
            </div>
        </EditForm>
    </div>

</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm]
    public FullLogin Model { get; set; } = new();
    private string? errMess;
    private bool HasErr = false;
    private bool PassErr = false;
    private string? returnUrl;
    //private ElementReference txtTaiKhoan;
    bool rememberMe { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var uri = NavMan.ToAbsoluteUri(NavMan.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query["returnUrl"];
        await vm.InitializeAsync();
    }
    private async Task Authenticate()
    {
        HasErr = false;
        PassErr = false;
        // if(string.IsNullOrEmpty(Model.UserID))
        // {
        //     errMess = "Chưa nhập tài khoản";
        //     HasErr = true;
        //     return;
        // }
        // if (string.IsNullOrEmpty(Model.Pass))
        // {
        //     errMess = "Chưa nhập mật khẩu";
        //     PassErr = true;
        //     return;
        // }
        string rs = await vm.Login(Model.UserID, Model.Password);
        errMess = rs;
        if (rs == "Tài khoản không tồn tại")
        {
            HasErr = true;
            return;
        }
        if (rs == "Mật khẩu không đúng")
        {
            PassErr = true;
            return;
        }
        if (rs != "Đăng nhập thành công") //đã kiểm tra hợp lệ User  + pass 
        {
            HasErr = true;
            return;
        }

        if (vm.LoggedUser != null)
        {
            string permit = vm.LoggedUser.UType == "1" ? "10|11|12|20|21|22|23|30|31|32|33|40|41|42|43|50|60|" : "";
            //permit += vm.LoggedUser.UType == "1" && vm.LoggedUser.Role == ""? "70|71|" : "";
            //đăng ký cookie thông qua authen cấp authen token
            var claims = new List<Claim>
            {
                new Claim("ID", vm.LoggedUser.id!.ToString()!),
                new Claim("UserID", vm.LoggedUser.UserID!),
                new Claim("UserName", vm.LoggedUser.LoginName!),
                new Claim("UType",vm.LoggedUser.UType!),
                new Claim("Permit", permit )
            };
            var claimIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(claimIdentity);

            if (HttpContext != null && HttpContext.Request.Form.TryGetValue("RememberMe", out var rememberVal))
            {
                rememberMe = string.Equals(rememberVal.ToString(), "true", StringComparison.OrdinalIgnoreCase);
            }
            else
            {
                rememberMe = false;
            }

            var expire = TimeSpan.FromMinutes(30);

            var authProperties = new AuthenticationProperties
            {
                IsPersistent = true,
                ExpiresUtc = DateTimeOffset.UtcNow.Add(expire),
                AllowRefresh = !rememberMe
            };
            if (HttpContext != null)
                await HttpContext.SignInAsync(
                    CookieAuthenticationDefaults.AuthenticationScheme,
                    principal,
                    authProperties);
            await Task.Delay(200);

            HttpContext.Response.Redirect(returnUrl ?? "/");
        }
    }
}
