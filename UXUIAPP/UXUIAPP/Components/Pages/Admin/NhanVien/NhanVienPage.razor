@page "/admin/nhanvien"
@using UXUIAPP.Components.Common
@using UXUIAPP.Components.Common.Actions
@rendermode InteractiveServer

@layout AdminLayout

<PageTitle>Nhân viên</PageTitle>

<div class="employee-page">

    <div class="page-header">
        <div class="page-title"> 
            <h1>Nhân viên</h1>
            <p>Quản lý thông tin nhân viên cửa hàng </p>
        </div>

        <SearchBox />

    </div>

    <div class="page-toolbar">
        <div class="employee-total">
            Tổng: @employeeCount nhân viên
        </div>
        
        @*<div class="employee-total">
        Tổng: @Employees.Count nhân viên
    </div>*@

        <AddButton OnClick="OpenAddModal" />
    </div>

    <div class="employee-table-wrapper"> 

        <table class="employee-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nhân Viên</th>
                    <th>Email</th>
                    <th>Mã Nhân Viên</th>
                    <th class="employee-action-column">
                        Thao tác
                    </th>
                </tr>
            </thead>

            <tbody>
                @* dữ liệu render từ ViewModel *@

                <tr>
                    <td colspan="5" class="empty-row"> 
                        Chưa có dữ liệu nhân viên
                    </td>
                </tr>
            </tbody>

        </table>
    </div>


    <Pagination />

    <NhanVienModal 
        IsVisible="showEmployeeModal"
        OnClose="CloseEmployeeModal" />

</div>


@code 
{
    private bool showEmployeeModal = false;

    private int employeeCount = 0 ;

    private void OpenAddModal()
    {
        showEmployeeModal = true;
    }

    private void CloseEmployeeModal()
    {
        showEmployeeModal = false;   
    }
}


