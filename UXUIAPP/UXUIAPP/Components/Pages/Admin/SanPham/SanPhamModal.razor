@if (IsVisible)
{
    <div class="product-modal-overlay">

        <div class="product-modal">

            <!-- HEADER -->
            <div class="product-modal-header">

                <h2>Thêm sản phẩm</h2>

                <button class="product-modal-close"
                        @onclick="CloseModal">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!-- BODY -->
            <div class="product-modal-body">

                <div class="product-form">


                    <!-- MÃ SẢN PHẨM -->

                    <div class="form-group">

                        <label>
                            Mã sản phẩm
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Nhập mã sản phẩm" />

                    </div>


                    <!-- TÊN SẢN PHẨM -->

                    <div class="form-group">

                        <label>
                            Tên sản phẩm
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Nhập tên sản phẩm" />

                    </div>


                    <!-- HÌNH ẢNH -->

                    <div class="form-group">

                        <label>
                            Hình ảnh
                        </label>

                        <input type="file"
                               class="form-control" />

                    </div>


                    <!-- THƯƠNG HIỆU -->

                    <div class="form-group">

                        <label>
                            Thương hiệu
                        </label>

                        <select class="form-control">

                            <option value="">
                                -- Chọn thương hiệu --
                            </option>

                        </select>

                    </div>


                    <!-- DANH MỤC -->

                    <div class="form-group">

                        <label>
                            Danh mục
                        </label>

                        <select class="form-control">

                            <option value="">
                                -- Chọn danh mục --
                            </option>

                        </select>

                    </div>


                    <!-- MÔ TẢ -->

                    <div class="form-group">

                        <label>
                            Mô tả
                        </label>

                        <textarea class="form-control"
                                  rows="4"
                                  placeholder="Nhập mô tả sản phẩm">
                        </textarea>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="product-modal-footer">

                <button class="form-button cancel"
                        @onclick="CloseModal">

                    Hủy

                </button>


                <button class="form-button save">

                    <i class="bi bi-check-lg"></i>

                    Lưu

                </button>

            </div>

        </div>

    </div>
}


@code
{
    [Parameter]
    public bool IsVisible { get; set; }


    [Parameter]
    public EventCallback OnClose { get; set; }


    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }
}