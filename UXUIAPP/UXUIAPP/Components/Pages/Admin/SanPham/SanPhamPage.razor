@page "/admin/sanpham"
@using UXUIAPP.Components.Common
@using UXUIAPP.Components.Common.Actions
@rendermode InteractiveServer

@layout AdminLayout

<PageTitle>Sản phẩm</PageTitle>

<div class="product-page">

    <div class="page-header">

        <div class="page-title">
            <h1>Sản phẩm</h1>
            <p>Quản lý thông tin sản phẩm cửa hàng</p>
        </div>

    </div>

    <div class="page-toolbar">

        <div class="product-total">
            Tổng: @productCount sản phẩm
        </div>

        @* <div class="employee-total">
        Tổng: @Product.Count nhân viên
    </div>`*@

        <AddButton OnClick="OpenAddModal" />

    </div>

    <div class="product-table-wrapper">

        <table class="product-table">

            <thead>
                <tr>
                    <th>Mã SP</th>
                    <th>Tên sản phẩm</th>
                    <th>Hình ảnh</th>
                    <th>Thương hiệu</th>
                    <th>Danh mục</th>
                    <th>Ngày tạo</th>
                    <th class="product-action-column">
                        Thao tác
                    </th>
                </tr>
            </thead>


            <tbody>

                @* 
                    dữ liệu sản phẩm sẽ được render từ ViewModel / Backend
                *@

                <tr>
                    <td colspan="7" class="empty-row">
                        Chưa có dữ liệu sản phẩm
                    </td>
                </tr>

            </tbody>

        </table>

    </div>


    <Pagination />

    <SanPhamModal IsVisible="showProductModal"
                  OnClose="CloseProductModal" />

</div>


@code
{
    private bool showProductModal = false;
    private int productCount = 0;

    private void OpenAddModal()
    {
        showProductModal = true;
    }


    private void CloseProductModal()
    {
        showProductModal = false;
    }
}



