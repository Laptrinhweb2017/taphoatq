@page "/admin"

@layout AdminLayout

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-header">
    <div>
        <h1>Tổng quan cửa hàng</h1>
        <p>Chào mừng bạn đã quay trở lại.</p>
    </div>
</div>

<div class="dashboard-grid">

    <section class="quick-actions">
     <div class="section-title"> 
         <i class="bi bi-lightning-charge-fill"></i>
         <span>Thao Tác Nhanh</span>
     </div>

     <div class="quick-action-grid">
         <a href="/orders" class="quick-action-item">
            <i class="bi bi-cart-plus-fill"></i>
            <span>Tạo Đơn Hàng</span>
         </a>

         <a href="/stock-input" class="quick-action-item">
             <i class="bi bi-box-arrow-in-down"></i>
             <span>Nhập Kho</span>
         </a>

          <a href="/customer" class="quick-action-item">
             <i class="bi bi-person-plus-fill"></i>
             <span>Khách hàng</span>
           </a>

          <a href="/product" class="quick-action-item">
              <i class="bi bi-box-seam-fill"></i>
              <span>Sản phẩm</span>
          </a>
     </div>
    </section>

    <div class="dashboard-right">
        <section class="dashboard-panel">
            <div class="section-title">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>Cần xử lý</span>
            </div>

            <div class="action-list">
                @* Dữ liệu sẽ được render từ ViewModel *@
                @foreach (var item in PendingItems)
                {
                    <a href="@item.Url" class="action-row">
                        <div class="action-info">
                            <i class="@item.Icon"></i>

                            <div>
                                <strong>@item.Title</strong>
                                <span>@item.Description</span>
                            </div>
                        </div>

                        <i class="bi bi-chevron-right action-arrow"></i>
                    </a>
                }
            </div>
        </section>


        <section class="dashboard-panel">
            <div class="section-title">
                <i class="bi bi-clock-history"></i>
                <span>Hoạt động gần đây</span>
            </div>

            <div class="activity-list">
                @* Dữ liệu hoạt động sẽ được kết nối sau *@
                @foreach (var activity in RecentActivities)
                {
                    <div class="activity-row">
                        <i class="@activity.Icon"></i>
                        <div>
                            <strong>@activity.Title</strong>
                            <span>@activity.Time</span>
                        </div>
                    </div>
                }
            </div>
        </section>

    </div>

</div>


@code
{
    private List<PendingItem> PendingItems = new()
    {
    };

    private List<RecentActivity> RecentActivities = new()
    {
    };

    private class PendingItem
    {
        public string Title { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string Icon { get; set; } = string.Empty;

        public string Url { get; set; } = string.Empty;
    }

    private class RecentActivity
    {
        public string Title { get; set; } = string.Empty;

        public string Time { get; set; } = string.Empty;

        public string Icon { get; set; } = string.Empty;
    }
}