@rendermode InteractiveServer

<div class="sidebar-wrapper @(sidebarCollapsed ? "sidebar-collapsed" : "")">

    <div class="sidebar-home">

        <a href="/admin">
            <i class="bi bi-house-fill"></i>
            <span>Trang Chủ</span>
        </a>

        <button class="sidebar-toggle"
                @onclick="ToggleSidebar">

            <i class="bi @(sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>

        </button>

    </div>

    <!-- Menu -->
    @foreach (var menu in MenuGroups)
    {
        <div class="menu-group">
            <div class="menu-title">

                <div class="menu-title-left">
                    <i class="@menu.Icon"></i>
                    <span>@menu.Title</span>
                </div>

                <button class="menu-arrow-button"
                        @onclick="() => ToggleMenu(menu)">
                    <i class="bi @(menu.IsOpen ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                </button>

            </div>

            <div class="menu-sub @(menu.IsOpen ? "menu-sub-open" : "menu-sub-closed")">
                @foreach (var item in menu.Items)
                {
                    <a href="@item.Link" class="menu-item"> 
                        <i class="@item.Icon"></i>
                        <span>@item.Title</span>
                    </a>
                }
            </div>

        </div>
    }

    <!-- Thông tin cửa hàng -->
    <div class="menu-single">
        <a href="/store-info"
           class="menu-title single">

            <div class="menu-title-left">
                <i class="bi bi-info-square-fill"></i>
                <span>Thông Tin Cửa Hàng</span>
            </div>

        </a>
    </div>

</div>


